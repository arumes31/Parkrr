      "description": "Tinted state badge with mono label type.",
      "html": "<span class=\"ds-badge\">bezahlt · Rechnung</span>",
      "css": ".ds-badge{display:inline-block;padding:.15rem .5rem;border-radius:999px;background:color-mix(in srgb,var(--success,#4CC985) 16%,transparent);color:var(--success-text,#7BD8A4);font:700 .6875rem 'Hanken Grotesk',system-ui,sans-serif}"
