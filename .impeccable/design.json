      "css": ".ds-toast{display:inline-flex;align-items:center;gap:.75rem;padding:.6rem .7rem .6rem 1.2rem;border:1px solid var(--border,#24312E);border-radius:999px;background:var(--bg-elev-2,#182321);color:var(--text,#E8F0EE);box-shadow:0 1px 2px rgba(0,0,0,.35),0 14px 34px rgba(0,0,0,.45);font:600 1rem 'Hanken Grotesk',system-ui,sans-serif}.ds-toast button{border:0;border-radius:999px;padding:.3rem .8rem;background:var(--primary,#2FB3A8);color:var(--on-primary,#06211E);font:700 .875rem 'Bricolage Grotesque',system-ui,sans-serif;cursor:pointer}"
    }
