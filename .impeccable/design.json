  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one main action of a view.",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">+ Gefährt</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;min-height:44px;padding:.6rem 1rem;border:1px solid transparent;border-radius:12px;background:var(--primary,#2FB3A8);color:var(--on-primary,#06211E);font:700 1rem 'Bricolage Grotesque',system-ui,sans-serif;cursor:pointer;transition:background .15s ease,transform .05s ease}.ds-btn-primary:hover{background:var(--primary-hover,#4CC9BE)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid var(--primary-hover,#4CC9BE);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary actions; the border is the control cue.",
      "html": "<button class=\"ds-btn-ghost\" type=\"button\">Mehrfachauswahl</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;gap:.4rem;min-height:36px;padding:.35rem .7rem;border:1px solid var(--text-muted,#8CA09B);border-radius:12px;background:transparent;color:var(--text,#E8F0EE);font:700 .875rem 'Bricolage Grotesque',system-ui,sans-serif;cursor:pointer}.ds-btn-ghost:hover{background:var(--bg-elev-2,#182321)}.ds-btn-ghost:focus-visible{outline:2px solid var(--primary-hover,#4CC9BE);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Canvas-filled field with a petrol focus halo.",
      "html": "<label class=\"ds-field\"><span>Kennzeichen</span><input class=\"ds-input\" value=\"DEMO-0\"></label>",
      "css": ".ds-field{display:grid;gap:.35rem;font:600 .875rem 'Hanken Grotesk',system-ui,sans-serif;color:var(--text-muted,#8CA09B)}.ds-input{padding:.65rem .75rem;border:1px solid var(--border,#24312E);border-radius:12px;background:var(--bg,#0C1312);color:var(--text,#E8F0EE);font:400 1rem 'Hanken Grotesk',system-ui,sans-serif}.ds-input:focus{outline:none;border-color:var(--primary,#2FB3A8);box-shadow:0 0 0 3px var(--primary-soft,rgba(47,179,168,.14))}"
    },
    {
      "name": "State Switch",
      "kind": "custom",
      "refersTo": "segmented-control",
      "description": "Sliding-thumb switch for record states (stored / reserved / collected, open / paid).",
      "html": "<div class=\"ds-seg\" role=\"radiogroup\" aria-label=\"Zahlstatus · Demo Wohnmobil 1\"><button role=\"radio\" aria-checked=\"true\" class=\"on\">offen</button><button role=\"radio\" aria-checked=\"false\">bezahlt</button></div>",
