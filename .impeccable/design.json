    {
      "name": "Record Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Whole-card navigation with one chevron; inner buttons stay separate targets.",
      "html": "<article class=\"ds-card\"><div><h3><a href=\"#\">Demo Berger 1</a></h3><p>demo0@example.invalid · +43 000 000000</p><button class=\"ds-sect\" type=\"button\"><svg viewBox=\"0 0 24 24\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 21s-6-5.3-6-10a6 6 0 0 1 12 0c0 4.7-6 10-6 10Z\"/><circle cx=\"12\" cy=\"11\" r=\"2.3\"/></svg> Im Plan platzieren</button></div><span class=\"ds-chev\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 6l6 6-6 6\"/></svg></span></article>",
      "css": ".ds-card{position:relative;display:flex;justify-content:space-between;gap:.75rem;padding:1rem 2.6rem 1rem 1rem;border:1px solid var(--card-border,#24312E);border-radius:14px;background:var(--card-bg,#121B19);box-shadow:0 1px 2px rgba(0,0,0,.35),0 10px 28px rgba(0,0,0,.35);color:var(--text,#E8F0EE);font:400 .875rem 'Hanken Grotesk',system-ui,sans-serif}.ds-card h3{margin:0 0 .2rem;font:700 1.125rem 'Bricolage Grotesque',system-ui,sans-serif}.ds-card h3 a{color:inherit;text-decoration:none}.ds-card h3 a::after{content:'';position:absolute;inset:0}.ds-card p{margin:0;color:var(--text-muted,#8CA09B)}.ds-card:hover{border-color:color-mix(in srgb,var(--primary,#2FB3A8) 45%,var(--card-border,#24312E))}.ds-sect{position:relative;z-index:1;display:inline-flex;align-items:center;gap:.3rem;margin:.35rem 0 0 -.55rem;padding:.35rem .55rem;border:0;border-radius:12px;background:none;color:var(--primary-ink,#5ED4C9);font:600 .875rem 'Hanken Grotesk',system-ui,sans-serif;cursor:pointer}.ds-sect:hover{background:var(--primary-soft,rgba(47,179,168,.14))}.ds-chev{position:absolute;right:.75rem;top:50%;transform:translateY(-50%);display:flex;color:var(--text-muted,#8CA09B);pointer-events:none}"
    },
    {
      "name": "Tab Bar Item",
      "kind": "nav",
      "refersTo": "tab-active",
      "description": "Bottom-bar destination; active in Petrol Ink on a soft petrol pill.",
      "html": "<nav class=\"ds-tabs\"><button class=\"ds-tab on\" aria-current=\"page\"><span class=\"pill\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 6l6 6-6 6\"/></svg></span><span>Übersicht</span></button><button class=\"ds-tab\"><span class=\"pill\"><svg viewBox=\"0 0 24 24\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 21s-6-5.3-6-10a6 6 0 0 1 12 0c0 4.7-6 10-6 10Z\"/><circle cx=\"12\" cy=\"11\" r=\"2.3\"/></svg></span><span>Stellplätze</span></button></nav>",
      "css": ".ds-tabs{display:flex;gap:4px;padding:6px;border-top:1px solid var(--glass-border,rgba(232,240,238,.08));background:var(--bg-elev,#121B19)}.ds-tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;border:0;background:none;color:var(--text-muted,#8CA09B);font:600 .6875rem 'Hanken Grotesk',system-ui,sans-serif;white-space:nowrap;cursor:pointer}.ds-tab .pill{display:flex;align-items:center;justify-content:center;width:48px;height:28px;border-radius:999px}.ds-tab.on{color:var(--tab-active,#5ED4C9)}.ds-tab.on .pill{background:var(--primary-soft,rgba(47,179,168,.14))}.ds-tab:focus-visible{outline:2px solid var(--primary,#2FB3A8);outline-offset:-3px}"
    },
